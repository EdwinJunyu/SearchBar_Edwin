<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools/**;.data/**</DefaultItemExcludes>
    <ReverseModelDirectory Condition="'$(ReverseModelDirectory)' == ''">$(E_SEARCH_REVERSE_MODEL)</ReverseModelDirectory>
  </PropertyGroup>
  <!-- 仅显式指定时随包交付已核验的模型目录。限制复制文件名，避免带入用户缓存、测试数据或其它权重。 -->
  <ItemGroup Condition="'$(ReverseModelDirectory)' != ''">
    <_ReverseModelFile Include="$(ReverseModelDirectory)/model.onnx;$(ReverseModelDirectory)/vocab.txt;$(ReverseModelDirectory)/LICENSE.txt;$(ReverseModelDirectory)/provenance.json" />
    <_ReverseModelFile Include="$(ReverseModelDirectory)/MODEL-CARD.md" Condition="Exists('$(ReverseModelDirectory)/MODEL-CARD.md')" />
    <_ReverseModelFile Include="$(ReverseModelDirectory)/CONVERSION.md" Condition="Exists('$(ReverseModelDirectory)/CONVERSION.md')" />
    <Content Include="@(_ReverseModelFile)" Link="models/bge-small-zh-v1.5/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- 透明 WPF 浮窗的 WebView2 合成控件需要 Windows 10 1809 WinRT 投影。 -->
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.17763.0</TargetPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 发布目录位于 bin/Release/net10.0-windows/publish，可使用项目私有或系统运行时。 -->
    <AppHostDotNetSearch Condition="'$(SelfContained)' != 'true'">AppRelative;EnvironmentVariable;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet Condition="'$(SelfContained)' != 'true'">../../../../.tools/dotnet</AppHostRelativeDotNet>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" GeneratePathProperty="true" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt;$(PkgMicrosoft_Web_WebView2)/NOTICE.txt"
             Condition="'$(PkgMicrosoft_Web_WebView2)' != ''" Link="licenses/WebView2-%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms;System.Drawing" />
    <Using Include="System.IO" />
    <Content Include=".tools/everything/dll/Everything32.dll;.tools/everything/dll/Everything64.dll;.tools/everything/dll/EverythingARM64.dll"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include=".tools/everything/Everything-SDK-LICENSE.txt" Link="licenses/Everything-SDK-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 发布时可传入一致的 SQLite 备份，避免直接复制正在写入的词库。 -->
    <Content Include="$(DictionarySeed)" Condition="'$(DictionarySeed)' != ''"
             Link="Data/dictionaries.db" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 发布原有单文件种子或带按需正文的种子，均用实际数据库引用决定随包的原书。 -->
  <Target Name="IncludeIndexedSeedSources" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(DictionarySeed)' != '' and '$(TargetFramework)' == 'net10.0-windows'">
    <PropertyGroup>
      <_SeedPath>$([System.IO.Path]::GetFullPath('$(DictionarySeed)', '$(MSBuildProjectDirectory)'))</_SeedPath>
      <_SeedDirectory>$([System.IO.Path]::GetDirectoryName('$(_SeedPath)'))</_SeedDirectory>
    </PropertyGroup>
    <Exec Command="&quot;$(NetCoreRoot)dotnet.exe&quot; &quot;$(TargetPath)&quot; indexed-sources"
          EnvironmentVariables="E_SEARCH_DB=$(_SeedPath)" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SeedHashes"/>
    </Exec>
    <Exec Command="&quot;$(NetCoreRoot)dotnet.exe&quot; &quot;$(TargetPath)&quot; merged-resources"
          EnvironmentVariables="E_SEARCH_DB=$(_SeedPath)" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ResourceHashes"/>
    </Exec>
    <GetFileHash Files="@(_ResourceHashes->'$(_SeedDirectory)/merged-resources/%(Identity).mdd')" Algorithm="SHA256"
                 Condition="'@(_ResourceHashes)' != ''">
      <Output TaskParameter="Items" ItemName="_MergedSeedFiles"/>
    </GetFileHash>
    <Error Condition="'%(_MergedSeedFiles.Filename)' != '%(_MergedSeedFiles.FileHash)'"
           Text="种子引用的 MDD 内容哈希不匹配：%(_MergedSeedFiles.Identity)"/>
    <GetFileHash Files="@(_SeedHashes->'$(_SeedPath).sources/%(Identity).mdx')" Algorithm="SHA256"
                 Condition="'@(_SeedHashes)' != ''">
      <Output TaskParameter="Items" ItemName="_IndexedSeedFiles"/>
    </GetFileHash>
    <Error Condition="'%(_IndexedSeedFiles.Filename)' != '%(_IndexedSeedFiles.FileHash)'"
           Text="种子引用的 MDX 内容哈希不匹配：%(_IndexedSeedFiles.Identity)"/>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_IndexedSeedFiles)" RelativePath="Data/dictionaries.db.sources/%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest"/>
      <ResolvedFileToPublish Include="@(_MergedSeedFiles)" RelativePath="Data/merged-resources/%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
  </Target>
  <!-- 下载一次并校验官方 SDK；以后的桌面构建复用缓存，命令行目标不依赖 SDK。 -->
  <Target Name="PrepareEverythingSdk" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PropertyGroup>
      <_SdkCache>$(MSBuildProjectDirectory)/.tools/everything</_SdkCache>
      <_SdkZip>$(_SdkCache)/Everything-SDK.zip</_SdkZip>
    </PropertyGroup>
    <MakeDir Directories="$(_SdkCache)" />
    <DownloadFile SourceUrl="https://www.voidtools.com/Everything-SDK.zip" DestinationFolder="$(_SdkCache)"
                  DestinationFileName="Everything-SDK.zip" Condition="!Exists('$(_SdkZip)')" />
    <VerifyFileHash File="$(_SdkZip)" Algorithm="SHA256" Hash="F5716D9513CCE6B462B5170A0A2E7E081E191D9BCAC6774F5DECC061497DF443" />
    <Unzip SourceFiles="$(_SdkZip)" DestinationFolder="$(_SdkCache)" Include="dll/*.dll;src/Everything.c" SkipUnchangedFiles="true" />
    <PropertyGroup>
      <!-- 将上游实现自带的完整版权和许可声明随 DLL 一并发布。 -->
      <_SdkSource>$([System.IO.File]::ReadAllText('$(_SdkCache)/src/Everything.c'))</_SdkSource>
      <_SdkNotice>$(_SdkSource.Substring(0, $(_SdkSource.IndexOf('// Notes:'))))</_SdkNotice>
    </PropertyGroup>
    <WriteLinesToFile File="$(_SdkCache)/Everything-SDK-LICENSE.txt" Lines="$(_SdkNotice)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="SearchWindow.xaml.cs;SettingsWindow.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="2.1.11" />
    <!-- 中文释义反查在 Windows CPU 上运行本地 ONNX 模型，命令行与桌面使用同一个推理运行时。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" GeneratePathProperty="true" />
    <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)/LICENSE;$(PkgMicrosoft_ML_OnnxRuntime)/ThirdPartyNotices.txt"
             Condition="'$(PkgMicrosoft_ML_OnnxRuntime)' != ''" Link="licenses/OnnxRuntime-%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
