<Window x:Class="ESearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E_Search 设置" Width="800" Height="658" MinWidth="520" MinHeight="390"
        WindowStartupLocation="CenterScreen" Language="zh-CN" Background="White"
        FontFamily="Segoe UI, Microsoft YaHei UI, Yu Gothic UI" FontSize="14" Foreground="#172C39"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#165D68"/>
        <SolidColorBrush x:Key="Muted" Color="#506770"/>
        <SolidColorBrush x:Key="Divider" Color="#D5DFE2"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="MinHeight" Value="33"/>
            <Setter Property="Background" Value="#F6F9FA"/>
            <Setter Property="Foreground" Value="#172C39"/>
            <Setter Property="BorderBrush" Value="#ADC0C5"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#172C39"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#172C39"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabSurface" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="TabLabel" ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="{StaticResource Accent}"/>
                            <Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E0EFF0"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#EFF5F5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Message" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
        </Style>
    </Window.Resources>
    <TabControl Margin="18,10,18,15" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Divider}" Padding="10,16,10,0">
        <TabItem x:Name="CatalogTab" Header="我的词库">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="词典优先级" Style="{StaticResource Heading}"/>
                    <TextBlock Text="同级匹配优先显示靠前的词典。选中词典后可以移动或停用。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MoveUpButton" Content="↑ 上移" Click="MoveUp"/>
                        <Button x:Name="MoveDownButton" Content="↓ 下移" Click="MoveDown" Margin="6,0,14,0"/>
                        <Button x:Name="ToggleEnabledButton" Content="停用词典" Click="ToggleEnabled"/>
                        <Button x:Name="RestoreSourceButton" Content="重新定位原档…" Margin="8,0,0,0" Visibility="Collapsed" Click="RestoreSource"/>
                    </StackPanel>
                    <Button x:Name="CancelRestoreButton" Content="取消恢复" HorizontalAlignment="Left" Visibility="Collapsed" Click="CancelOperation"/>
                    <TextBlock x:Name="CatalogStatus" Style="{StaticResource Message}" Margin="0,8,0,0"/>
                </StackPanel>
                <ListBox x:Name="DictionaryList" AutomationProperties.Name="按优先级排列的词典" SelectionChanged="CatalogSelected" BorderBrush="{StaticResource Divider}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Filename}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Position}" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Filename}"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
        <TabItem x:Name="ImportTab" Header="导入词库">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,9,0">
                    <TextBlock Text="导入词库" Style="{StaticResource Heading}"/>
                    <Grid x:Name="ImportForm">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Label Target="{Binding ElementName=ImportPath}" Content="词典文件（MDX、CSV 或 TSV）"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ImportPath" AutomationProperties.Name="词典文件路径" TextChanged="PathChanged" KeyDown="PathKeyDown"/>
                                <Button x:Name="BrowseButton" Content="浏览…" Grid.Column="1" Margin="6,0,0,0" Click="Browse"/>
                                <Button x:Name="PreviewButton" Content="读取文件" Grid.Column="2" Margin="6,0,0,0" Click="Preview"/>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Target="{Binding ElementName=ImportTarget}" Content="导入目标"/>
                                <ComboBox x:Name="ImportTarget" DisplayMemberPath="Name" AutomationProperties.Name="导入目标" SelectionChanged="ImportTargetChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Target="{Binding ElementName=ImportLanguage}" Content="词头语言"/>
                                <ComboBox x:Name="ImportLanguage" SelectedIndex="0" AutomationProperties.Name="词头语言">
                                    <ComboBoxItem Content="日语" Tag="ja"/><ComboBoxItem Content="英语" Tag="en"/><ComboBoxItem Content="中文" Tag="zh"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="TablePanel" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,0">
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock Text="预览与列映射" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="HasHeader" Content="首行为表头" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="HeaderChanged" Unchecked="HeaderChanged"/>
                            </DockPanel>
                            <DataGrid x:Name="PreviewGrid" AutomationProperties.Name="原始列与样例行" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                                      HeadersVisibility="Column" AutoGenerateColumns="False" MinHeight="56" MaxHeight="150"
                                      EnableColumnVirtualization="True" BorderBrush="{StaticResource Divider}" Background="#F8FBFB"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4ECEE" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><Label Target="{Binding ElementName=HeadColumn}" Content="词头（必填）"/><ComboBox x:Name="HeadColumn" AutomationProperties.Name="词头列"/></StackPanel>
                                <StackPanel Grid.Column="2"><Label Target="{Binding ElementName=GlossColumn}" Content="释义（必填）"/><ComboBox x:Name="GlossColumn" AutomationProperties.Name="释义列"/></StackPanel>
                                <StackPanel Grid.Column="4"><Label Target="{Binding ElementName=ReadingColumn}" Content="读音（可选）"/><ComboBox x:Name="ReadingColumn" AutomationProperties.Name="读音列"/></StackPanel>
                            </Grid>
                            <TextBlock x:Name="ReadingColumnHint" Visibility="Collapsed" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="如果读音列尚未出现在样例中，可在“读音”框直接输入列号（从 1 开始）。"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="ImportButton" Content="导入词库" Style="{StaticResource Primary}" IsEnabled="False" Click="Import"/>
                        <Button x:Name="CancelImportButton" Content="取消导入" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelOperation"/>
                    </StackPanel>
                    <ProgressBar x:Name="ImportProgress" Height="5" Margin="0,9,0,0" Minimum="0" Maximum="1"
                                 Visibility="Collapsed" AutomationProperties.Name="词典导入进度"/>
                    <TextBlock x:Name="ImportStatus" Style="{StaticResource Message}" Margin="0,9,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="文件重找">
            <StackPanel>
                <TextBlock Text="重找已打开的文件（实验）" Style="{StaticResource Heading}"/>
                <Label Target="{Binding ElementName=FileRefindMode}" Content="文件结果排序" Margin="0,10,0,0"/>
                <ComboBox x:Name="FileRefindMode" AutomationProperties.Name="文件结果排序" MinWidth="230" HorizontalAlignment="Left"
                          SelectionChanged="ChangeFileRefindMode" IsEnabled="False">
                    <ComboBoxItem Content="关闭（Everything 原序）"/>
                    <ComboBoxItem Content="最近打开优先"/>
                    <ComboBoxItem Content="经常打开优先（随时间衰减）"/>
                </ComboBox>
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="开启后，仅在本机保留最近 90 天内最多 256 个文件的打开记录。仅计入已交给 Windows 打开的文件。关闭即停止记录并恢复原序。"/>
                <Button x:Name="ClearFileRefindButton" Content="清除打开记录" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ClearFileRefind" IsEnabled="False"/>
                <TextBlock x:Name="FileRefindStatus" Style="{StaticResource Message}" Margin="0,9,0,0"/>
            </StackPanel>
        </TabItem>
        <TabItem x:Name="HotkeyTab" Header="快捷键">
            <StackPanel>
                <TextBlock Text="显示或隐藏搜索窗" Style="{StaticResource Heading}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,20">
                    <TextBlock Text="已保存的快捷键" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Background="#E4F0F0" Padding="10,5" Margin="12,0,0,0">
                        <TextBlock x:Name="CurrentHotkey" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
                <Label Target="{Binding ElementName=HotkeyCapture}" Content="新快捷键"/>
                <TextBox x:Name="HotkeyCapture" AutomationProperties.Name="新快捷键" MaxLength="62" MaxWidth="340" HorizontalAlignment="Left" MinWidth="225" PreviewKeyDown="CaptureKey"/>
                <TextBlock Text="可按下组合键，也可直接输入，如 Ctrl + Alt + K。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Button x:Name="SaveHotkeyButton" Content="保存快捷键" HorizontalAlignment="Left" Style="{StaticResource Primary}" Margin="0,16,0,0" Click="SaveHotkey"/>
                <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Message}" Margin="0,9,0,0"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
