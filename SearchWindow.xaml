<Window x:Class="ESearch.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E_Search" Width="736" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Language="zh-CN" FontFamily="Segoe UI, Microsoft YaHei UI, Yu Gothic UI"
        Foreground="#172C39" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172C39"/>
        <SolidColorBrush x:Key="Accent" Color="#165D68"/>
        <SolidColorBrush x:Key="Divider" Color="#D5DFE2"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" BorderThickness="1"
                                BorderBrush="Transparent" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EBF3F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D5E8E8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 输入和首义共用一行；输入框保留原生编辑器，让系统输入法管理组合文本和候选框。 -->
    <Border Margin="9" Background="White" BorderBrush="#B6C8CD" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#1F3842" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="18,0,12,0" Height="62">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 15,8.5 A 6.5,6.5 0 1 1 2,8.5 A 6.5,6.5 0 1 1 15,8.5 M 13.4,13.4 L 19,19"/>
                <Grid Grid.Column="1" Margin="13,0,0,0">
                    <TextBox x:Name="QueryBox" AutomationProperties.AutomationId="QueryBox"
                             AutomationProperties.Name="搜索词典和文件" VerticalContentAlignment="Center"
                             Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}"
                             FontSize="21" Padding="1,0" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                    <TextBlock Text="输入词语或文件名" Margin="2,0,0,0" IsHitTestVisible="False"
                               Foreground="#607780" FontSize="20" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button x:Name="ClearButton" AutomationProperties.AutomationId="ClearButton"
                        Grid.Column="2" Style="{StaticResource IconButton}" Visibility="Collapsed"
                        ToolTip="清空输入" AutomationProperties.Name="清空输入">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" StrokeThickness="1.5" Stroke="{StaticResource Accent}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <TextBlock x:Name="GlossText" AutomationProperties.AutomationId="GlossText"
                           Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right"
                           Margin="14,0,8,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Accent}" FontSize="17"/>
                <Button x:Name="DetailsButton" AutomationProperties.AutomationId="DetailsButton"
                        Grid.Column="4" Style="{StaticResource IconButton}" Visibility="Collapsed"
                        ToolTip="展开或收起词条 (Tab)" AutomationProperties.Name="展开或收起词条">
                    <Path Data="M 0,1 L 5,6 L 10,1" StrokeThickness="1.7" Stroke="{StaticResource Accent}"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=DetailsPanel}" Value="Visible">
                                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="5" Margin="4,0,0,0"
                        Style="{StaticResource IconButton}" ToolTip="设置"
                        AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="设置">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;"/>
                </Button>
            </Grid>

            <Border x:Name="DetailsPanel" AutomationProperties.AutomationId="DetailsPanel"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource Divider}" Visibility="Collapsed">
                <StackPanel Margin="20,15,20,17">
                    <ComboBox x:Name="CandidatePicker" AutomationProperties.AutomationId="CandidatePicker"
                              AutomationProperties.Name="选择词条和词典来源" DisplayMemberPath="Label"
                              HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                              Padding="8,3" MinHeight="30" MaxDropDownHeight="215" FontSize="13"/>
                    <ScrollViewer x:Name="DetailScroll" Margin="2,12,0,0" MaxHeight="215" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="EntryText" AutomationProperties.AutomationId="EntryText"
                                   TextWrapping="Wrap" FontSize="15" LineHeight="24" Padding="0,0,6,0"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                       Margin="20,0,20,12" TextWrapping="Wrap" Foreground="#844C18" Visibility="Collapsed"/>
            <!-- 文件名与路径分列，即使多个结果同名，用户也可以按目录区分。 -->
            <Border x:Name="FilePanel" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <StackPanel Margin="8,5,8,7">
                    <TextBlock x:Name="FileStatusText" AutomationProperties.AutomationId="FileStatusText"
                               Margin="12,8" Foreground="#506770" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button x:Name="InstallEverythingButton" AutomationProperties.AutomationId="InstallEverythingButton"
                            Content="下载 Everything" ToolTip="打开 Everything 官方下载页" HorizontalAlignment="Left"
                            Margin="12,0,12,6" Padding="9,3" Visibility="Collapsed"/>
                    <ListBox x:Name="FileList" AutomationProperties.AutomationId="FileList"
                             AutomationProperties.Name="文件结果" MaxHeight="280" Visibility="Collapsed"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding FullPath}"/>
                                <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Padding="10,6" Background="Transparent" BorderThickness="2,0,0,0"
                                                    BorderBrush="Transparent" CornerRadius="3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#F0F5F5"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#E0EFF0"/>
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="6*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Parent}" FontSize="12" Foreground="#506770"
                                               FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
